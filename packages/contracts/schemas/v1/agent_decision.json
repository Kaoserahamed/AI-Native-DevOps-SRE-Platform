{
  "$defs": {
    "AgentType": {
      "description": "The agents that can run inside the worker.",
      "enum": [
        "anomaly_agent",
        "incident_agent",
        "remediation_agent",
        "cost_agent"
      ],
      "title": "AgentType",
      "type": "string"
    },
    "AgentUsage": {
      "additionalProperties": false,
      "description": "Token, cost, latency and tool accounting for one agent run.",
      "properties": {
        "completion_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "evidence_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Evidence Bytes",
          "type": "integer"
        },
        "iterations": {
          "default": 0,
          "minimum": 0,
          "title": "Iterations",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "prompt_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "title": "AgentUsage",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "A verbatim quote from one evidence item, used to ground the diagnosis.",
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 280,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "DiagnosisCategory": {
      "description": "Diagnosis outcomes, including the honest \"we do not know\" outcome.",
      "enum": [
        "deployment_regression",
        "dependency_failure",
        "resource_exhaustion",
        "configuration_error",
        "traffic_anomaly",
        "code_defect",
        "infrastructure_event",
        "telemetry_gap",
        "insufficient_evidence",
        "no_action_required"
      ],
      "title": "DiagnosisCategory",
      "type": "string"
    },
    "RemediationCategory": {
      "description": "The only action classes the platform may ever propose.",
      "enum": [
        "restart_or_rollout",
        "rollback",
        "configuration_change",
        "resource_adjustment",
        "code_fix",
        "alert_tuning",
        "cost_optimization"
      ],
      "title": "RemediationCategory",
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/Kaoserahamed/AI-Native-DevOps-SRE-Platform/main/packages/contracts/schemas/v1/agent_decision.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One recorded agent decision with full provenance.",
  "properties": {
    "agent_type": {
      "$ref": "#/$defs/AgentType"
    },
    "agent_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]*$",
      "title": "Agent Version",
      "type": "string"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Decision Id",
      "type": "string"
    },
    "diagnosis": {
      "$ref": "#/$defs/DiagnosisCategory"
    },
    "evidence_ids": {
      "description": "Identifiers of the evidence that was provided to the agent.",
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "incident_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Incident Id",
      "type": "string"
    },
    "model": {
      "maxLength": 280,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "prompt_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]*$",
      "title": "Prompt Version",
      "type": "string"
    },
    "provider": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Provider",
      "type": "string"
    },
    "recommended_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemediationCategory"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "v1",
      "description": "Contract schema version. A breaking change requires a new version, never an edit.",
      "pattern": "^v[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "maxLength": 280,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "uncertainty": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty"
    },
    "usage": {
      "$ref": "#/$defs/AgentUsage"
    }
  },
  "required": [
    "decision_id",
    "run_id",
    "incident_id",
    "agent_type",
    "agent_version",
    "prompt_version",
    "provider",
    "model",
    "created_at",
    "diagnosis",
    "summary",
    "confidence"
  ],
  "title": "AgentDecision",
  "type": "object"
}
