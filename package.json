{
  "name": "ai-native-devops-sre-platform",
  "version": "0.0.0",
  "private": true,
  "description": "AI-native DevOps and SRE platform: repository tooling and demo application workspaces",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kaoserahamed/AI-Native-DevOps-SRE-Platform.git"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/demo-app/frontend"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:fix": "eslint . --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/typecheck.mjs",
    "test:frontend": "npm run test:coverage --workspace @demo-app/frontend",
    "test:frontend:smoke": "npm run test:smoke --workspace @demo-app/frontend",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:frontend"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
