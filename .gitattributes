# Normalize all text files to LF in the repository, regardless of developer OS.
* text=auto eol=lf

# Explicit text types
*.md text
*.mdx text
*.py text
*.pyi text
*.ts text
*.tsx text
*.js text
*.jsx text
*.mjs text
*.cjs text
*.json text
*.jsonc text
*.yml text
*.yaml text
*.toml text
*.ini text
*.cfg text
*.sh text
*.ps1 text
*.sql text
*.go text
*.tf text
*.tfvars text
*.rego text
Makefile text
Dockerfile text
*.dockerfile text

# Windows-only scripts keep CRLF so they run in legacy shells
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must never be normalized or diffed as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
*.tar binary

# Lockfiles are generated, so language statistics ignore them and GitHub collapses them in diffs, but
# they keep text diffs on purpose: the upgrade procedure in docs/18-governance.md requires reviewers to
# read the resolved version changes.
uv.lock linguist-generated
package-lock.json linguist-generated
go.sum linguist-generated
.terraform.lock.hcl linguist-generated

# Mark generated artifacts as vendored so language statistics stay meaningful
docs/diagrams/*.svg linguist-documentation
observability/grafana/dashboards/*.json linguist-generated
