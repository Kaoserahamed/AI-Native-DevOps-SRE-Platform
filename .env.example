# Demo API service — environment configuration.
# Copy to `.env` and adjust for your local environment. Never commit `.env`
# (see `scripts/check_repo_policy.py`); only `.env.example` is tracked.

# --- Application identity ---
APP_NAME=demo-api
APP_ENV=development
ENVIRONMENT=development
APP_VERSION=0.1.0

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
RELOAD=false

# --- Data stores ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/demo_api
REDIS_URL=redis://localhost:6379/0

# --- Observability ---
OTEL_ENDPOINT=http://localhost:4317
ENABLE_METRICS=true
ENABLE_TRACING=true

# Sentry (Error Tracking) - Optional
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Test-only failure injection (development only; rejected in staging/production) ---
FAILURE_MODE=
FAILURE_RATE=1.0

# --- AI Agent Configuration ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=30

# --- GitHub Integration ---
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# --- Approval Workflow ---
APPROVAL_EXPIRATION_MINUTES=60

# --- Incident Management ---
INCIDENT_DETECTION_SLO_SECONDS=120
INCIDENT_ACK_SLO_SECONDS=300

# --- Frontend configuration ---
# These variables are used by the Next.js frontend (apps/demo-app/frontend)
# Set these in a separate .env.local file in the frontend directory
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
SMOKE_SKIP_BUILD=false

# The demo frontend (apps/demo-app/frontend) is configured through the process environment, not through
# this file. This file becomes the demo API's `.env`, and the settings model rejects unknown keys at
# startup, so adding a frontend variable here would break the API. See docs/04-configuration.md.

