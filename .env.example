# Demo API service — environment configuration.
# Copy to `.env` and adjust for your local environment. Never commit `.env`
# (see `scripts/check_repo_policy.py`); only `.env.example` is tracked.

# --- Application identity ---
APP_NAME=demo-api
APP_ENV=development
APP_VERSION=0.1.0

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
RELOAD=false

# --- Data stores ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/demo_api
REDIS_URL=redis://localhost:6379/0

# --- Observability ---
OTEL_ENDPOINT=
ENABLE_METRICS=true
ENABLE_TRACING=true

# --- Test-only failure injection (development only; rejected in staging/production) ---
FAILURE_MODE=
FAILURE_RATE=1.0

# --- Frontend configuration (set in separate environment, not consumed by demo API) ---
# BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# SMOKE_SKIP_BUILD=false

# The demo frontend (apps/demo-app/frontend) is configured through the process environment, not through
# this file. This file becomes the demo API's `.env`, and the settings model rejects unknown keys at
# startup, so adding a frontend variable here would break the API. See docs/04-configuration.md.

